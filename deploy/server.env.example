# Copy outside the repository; chmod 600. No local-login fallback in server mode.
TRAINER_MODE=server
TRAINER_PUBLIC_ORIGIN=https://code-trainer.YOUR_SUBDOMAIN.workers.dev
TRAINER_ACCESS_DOMAIN=YOUR_TEAM.cloudflareaccess.com
TRAINER_ACCESS_AUDIENCE=CODE_TRAINER_ACCESS_APP_AUD
# Explicit, verified Access subject; never infer ownership from an email alone.
TRAINER_ACCESS_SUBJECT=
TRAINER_ACCESS_EMAIL=
TRAINER_ACCESS_USER_ID=
# App VM's host gateway -> Mac loopback SSH forward -> isolated runner.
# Server certificate SAN must match this app-facing address.
TRAINER_RUNNER_URL=https://192.168.5.2:18443
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
