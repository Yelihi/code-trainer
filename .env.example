# Copy this file to .env in the project root, fill it in, then run ./start.sh.
# Restart the server after changes. Existing shell variables take precedence.
# Never commit a real key.
AI_API_KEY=
# Required: model ID from your API provider (Chat Completions + Structured Outputs).
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
# Optional: required for GitHub token storage. Generate once; see docs/github-sharing.md.
TRAINER_GITHUB_ENCRYPTION_KEY=
# Personal AI keys: uses this Fernet key, or the GitHub encryption key above when empty.
TRAINER_AI_ENCRYPTION_KEY=
# Optional
# TRAINER_DB=data/trainer.sqlite3
# TRAINER_IMAGE=code-trainer-runner:v1
